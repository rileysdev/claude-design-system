{
  "name": "claude-design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/types/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens": "tsx scripts/build-tokens.ts",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css",
    "build": "pnpm tokens && pnpm build:js && pnpm build:types && pnpm build:css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "render-check": "tsx scripts/render-check.ts",
    "bundle": "tsx scripts/build-bundle.ts",
    "verify-bundle": "tsx scripts/verify-bundle.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.19",
    "@radix-ui/react-avatar": "^1.2.5",
    "@radix-ui/react-checkbox": "^1.3.10",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.23",
    "@radix-ui/react-label": "^2.1.14",
    "@radix-ui/react-popover": "^1.1.22",
    "@radix-ui/react-progress": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.4.6",
    "@radix-ui/react-scroll-area": "^1.2.17",
    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-separator": "^1.1.14",
    "@radix-ui/react-slot": "^1.3.2",
    "@radix-ui/react-switch": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.2.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "culori": "^4.0.2",
    "playwright": "^1.61.1",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
